{
  "schema": 1,
  "frame_budget_ms": 50,
  "minimum_fps": 22,
  "minimum_samples": {
    "navigation.remote_press_ms": 20,
    "navigation.remote_release_ms": 20,
    "animation.refresh_work_ms": 200,
    "animation.refresh_interval_ms": 200,
    "status_main_us": 20,
    "status_worker_us": 20,
    "status_radio_us": 20,
    "status_main_heap_us": 20
  },
  "limits": {
    "navigation.remote_press_ms": {"p95": 100, "max": 250},
    "navigation.remote_release_ms": {"p95": 120, "max": 250},
    "animation.refresh_work_ms": {"p95": 30, "max": 100},
    "animation.refresh_interval_ms": {"p95": 50, "max": 100},
    "animation.jank_percent": {"max": 5},
    "navigation.command_roundtrip_ms": {"p95": 750},
