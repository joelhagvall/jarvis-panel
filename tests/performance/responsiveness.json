    "navigation.remote_release_ms": {"statistic": "p95", "relative": 0.2, "absolute": 5},
    "navigation.remote_press_ms": {"statistic": "p95", "relative": 0.2, "absolute": 5},
    "animation.refresh_work_ms": {"statistic": "p95", "relative": 0.15, "absolute": 2},
    "animation.refresh_interval_ms": {"statistic": "p95", "relative": 0.1, "absolute": 3},
    "animation.jank_percent": {"statistic": "max", "relative": 0, "absolute": 1},
    "navigation.command_roundtrip_ms": {"statistic": "p95", "relative": 0.25, "absolute": 50},
    "status_roundtrip_ms": {"statistic": "p95", "relative": 0.25, "absolute": 50},
    "animation.fps": {"statistic": "median", "direction": "lower", "relative": 0.1, "absolute": 1}
